{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoenix Torrent",
  "version": "1.0.0",
  "identifier": "app.phoenix.torrent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phoenix Torrent",
        "width": 1180,
        "height": 760,
